# ===== DeepSeek API 配置 =====
# 把下面的 key 替换成你自己的 API Key（关键位置已预留）
LLM_API_KEY=sk-请在这里填入你的DeepSeek_API_Key

# DeepSeek OpenAI 兼容接口地址（也可写成 https://api.deepseek.com/v1）
LLM_BASE_URL=https://api.deepseek.com

# 模型名：轻量省钱用 deepseek-v4-flash；
# 复杂任务可选 deepseek-v4-pro（注意消耗较大，推理 token 多），按实际可用模型修改
LLM_MODEL=deepseek-v4-flash

# 思考开关：off = 关闭思考（快，10~40 秒）；on = 深度思考（慢，2~6 分钟）。仅 DeepSeek v4 生效
LLM_THINKING=off

# 数据目录（可选，默认 ./data）
# DATA_DIR=./data
